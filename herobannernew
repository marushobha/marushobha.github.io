
.hero-banner {
  width: 100%;
  min-height: 500px;
  background-image: url("images/marushobhabanner.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 768px) {
  .hero-banner {
    min-height: 300px;
    background-position: center;
  }
}
