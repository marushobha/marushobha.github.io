rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace REPLACE_WITH_YOUR_FIREBASE_AUTH_UID with your real Firebase Authentication UID.
    // Public storefronts may read active products; only the owner may create/update/delete products.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_AUTH_UID";
    }

    match /products/{productId} {
      allow read: if (resource.data.active == true) || isOwner();
      allow create, update, delete: if isOwner();
    }

    // Deny access to all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
